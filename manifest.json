{
  "manifest_version": 3,
  "name": "FINN+",
  "description": "Optional cleanup, appearance, and quality-of-life improvements for FINN.no.",
  "version": "0.1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.finn.no/*",
    "https://finn.no/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "settings/index.html",
  "action": {
    "default_title": "Open FINN+ settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.finn.no/*",
        "https://finn.no/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/feature-manager.js",
        "src/content/features/dark-mode.js",
        "src/content/features/remove-ai.js",
        "src/content/features/hide-ads.js",
        "src/content/settings-panel.js",
        "src/content/navigation.js",
        "src/content/index.js"
      ],
      "run_at": "document_start"
    }
  ]
}
